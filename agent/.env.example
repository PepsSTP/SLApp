# Anthropic API key — required for the Claude agent
ANTHROPIC_API_KEY=your_anthropic_api_key

# Linear Personal API token — required to poll issues
LINEAR_ACCESS_TOKEN=lin_api_your_token_here

# Name of the Linear user to assign issues to (default: "Claude Agent")
LINEAR_AGENT_USER=Claude Agent

# Slack incoming webhook URL — optional, for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
